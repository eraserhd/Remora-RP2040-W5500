#!/usr/bin/env python3
"""Process a tcpdump -xx log and print one summarized line per UDP packet."""

from datetime import datetime
import re
import struct
import sys


PACKET_RE = re.compile(r"""(?mx)
^(?P<timestamp>\d{2}:\d{2}:\d{2}\.\d+).*proto\sUDP.*\n
\s+(?P<sender>10\.10\.10\.\d+)\..*\n
(?P<data>(?:\s+0x00\d0:\s\s[\s\da-f]{40}.*\n)*)
"""
)

# Width for each joint value (right-justified), plus one char for '*' or ' '
NUM_WIDTH = 10

class Packet:
    def __init__(self, timestamp, sender, data):
        self.timestamp = timestamp
        self.sender = sender
        self.data = data

    @property
    def payload(self):
        ihl = (self.data[0] & 0x0F) * 4
        return self.data[ihl + 8:]

    @property
    def header(self):
        return bytes(reversed(self.payload[:4])).decode("latin-1", errors="replace")

    @property
    def direction(self):
        return ">" if self.sender == "10.10.10.10" else "<"

    @property
    def positions(self):
        return struct.unpack_from("<3i", self.payload, 4)

    def format(self, previous_packet, previous_writ, previous_data):
        if previous_data is None:
            delta_micros = 0
        else:
            delta = self.timestamp - previous_data.timestamp
            delta_micros = delta.seconds * 1_000_000 + delta.microseconds

        payload_text = ''
        if self.header == 'writ':
            joint_enable = self.payload[44]
            freq_cmds = struct.unpack_from("<3i", self.payload, 4)
            for cmd in freq_cmds:
                payload_text += f'{cmd:>10}{"*" if joint_enable & 1 else " "} {" ":>10} '
                joint_enable >>= 1
        elif self.header == 'data':
            if previous_data is None or previous_writ is None:
                for pos in self.positions:
                    payload_text += f'{pos:>10}  {" ":>10} '
            else:
                ts_delta = self.timestamp - previous_data.timestamp
                ts_delta_micros = ts_delta.seconds * 1_000_000 + ts_delta.microseconds
                ts_delta_seconds = ts_delta_micros / 1000000.0
                for (pos, prev) in zip(self.positions, previous_data.positions):
                    expected = int((pos - prev) / ts_delta_seconds)
                    payload_text += f'{pos:>10} ({expected:>10})'

        return f'{"+"+str(delta_micros):>5} {self.direction}{self.header.upper()} {payload_text}'

def main():
    with open(sys.argv[1]) as src:
        text = src.read()
    previous_p = None
    previous_writ = None
    previous_data = None
    for m in PACKET_RE.finditer(text):
        timestamp = datetime.strptime(m['timestamp'], '%H:%M:%S.%f')
        data = bytes.fromhex("".join([
            w
            for line in m.group('data').split('\n')
            for w in re.sub(r'^\s+0x00\d0:\s+', '', line)[:40] if w != ''
        ]))
        p = Packet(timestamp, m.group('sender'), data)
        print(p.format(previous_p, previous_writ, previous_data))
        previous_p = p
        if p.header == 'writ':
            previous_writ = p
        elif p.header == 'data':
            previous_data = p

if __name__ == "__main__":
    main()
