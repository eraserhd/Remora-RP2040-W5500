#!/usr/bin/env python3
"""Process a tcpdump -xx log and print one summarized line per UDP packet."""

import re
import struct
import sys

JOINTS = 6

# Packed int32 values decoded little-endian → human-readable name
HEADER_NAMES = {
    0x64617461: 'data',
    0x72656164: 'read',
    0x77726974: 'writ',
    0x65737470: 'estp',
    0x61636b6e: 'ackn',
    0x6572726f: 'erro',
}

# Width for each joint value (right-justified), plus one char for '*' or ' '
NUM_WIDTH = 10


def format_joints(values, enable_mask=None):
    parts = []
    for i, v in enumerate(values):
        s = f"{v:>{NUM_WIDTH}}"
        if enable_mask is None:
            s += " "
        else:
            s += "*" if (enable_mask >> i) & 1 else " "
        parts.append(s)
    return " ".join(parts)


def process_packet(ts, src_ip, raw_bytes):
    if src_ip is None:
        return None

    data = bytes(raw_bytes)
    if len(data) < 20:
        return None

    ihl = (data[0] & 0x0F) * 4
    if data[9] != 17:  # not UDP
        return None
    if len(data) < ihl + 8 + 4:
        return None

    payload = data[ihl + 8:]  # skip IP header + UDP header

    direction = ">" if src_ip.split(".")[-1] == "10" else "<"

    header_val = struct.unpack_from("<i", payload, 0)[0]
    header_name = HEADER_NAMES.get(
        header_val,
        bytes(reversed(payload[:4])).decode("latin-1", errors="replace"),
    )

    # rxData_t: writ packets — jointFreqCmd[6] at offset 4, jointEnable at offset 44
    if header_name == "writ" and len(payload) >= 45:
        freq_cmds = struct.unpack_from("<6i", payload, 4)
        joint_enable = payload[44]
        return f"{ts} {direction} {header_name}  {format_joints(freq_cmds, joint_enable)}"

    # txData_t: data packets — jointFeedback[6] at offset 4
    if header_name == "data" and len(payload) >= 28:
        feedbacks = struct.unpack_from("<6i", payload, 4)
        return f"{ts} {direction} {header_name}  {format_joints(feedbacks)}"

    return f"{ts} {direction} {header_name}"


def main():
    src = open(sys.argv[1]) if len(sys.argv) > 1 else sys.stdin

    TIMESTAMP_RE = re.compile(r"^(\d{2}:\d{2}:\d{2}\.\d+) ")
    FLOW_RE = re.compile(r"^\s+(\d+\.\d+\.\d+\.\d+)\.\d+ > ")
    HEX_RE = re.compile(r"^\s+0x[0-9a-f]+:\s+([\s0-9a-f]+)", re.I)

    current_ts = None
    current_src = None
    current_bytes = []

    def flush():
        result = process_packet(current_ts, current_src, current_bytes)
        if result:
            print(result)

    try:
        for line in src:
            m = TIMESTAMP_RE.match(line)
            if m:
                if current_ts:
                    flush()
                current_ts = m.group(1)
                current_src = None
                current_bytes = []
                continue

            if current_ts and current_src is None:
                m = FLOW_RE.match(line)
                if m:
                    current_src = m.group(1)
                    continue

            if current_ts:
                m = HEX_RE.match(line)
                if m:
                    hex_only = m.group(1).split("  ", 1)[0]
                    current_bytes.extend(
                        int(h, 16)
                        for h in re.findall(r"[0-9a-f]{2}", hex_only, re.I)
                    )
        if current_ts:
            flush()
    finally:
        if len(sys.argv) > 1:
            src.close()


if __name__ == "__main__":
    main()
